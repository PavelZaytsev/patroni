PATRONI_RESTAPI_USERNAME=admin
PATRONI_RESTAPI_PASSWORD=admin
PATRONI_SUPERUSER_USERNAME=postgres
PATRONI_SUPERUSER_PASSWORD=postgres
PATRONI_REPLICATION_USERNAME=replicator
PATRONI_REPLICATION_PASSWORD=replicate
PATRONI_admin_PASSWORD=admin
PATRONI_admin_OPTIONS=createdb,createrole

# PostgreSQL 17 configuration for logical replication testing
PATRONI_POSTGRESQL_VERSION=17
PATRONI_POSTGRESQL_BIN=/usr/lib/postgresql/17/bin
PATRONI_POSTGRESQL_PARAMETERS_LISTEN_ADDRESSES='*'
PATRONI_POSTGRESQL_PARAMETERS_PORT=5432
PATRONI_POSTGRESQL_PARAMETERS_WAL_LEVEL=logical
PATRONI_POSTGRESQL_PARAMETERS_MAX_REPLICATION_SLOTS=10
PATRONI_POSTGRESQL_PARAMETERS_MAX_WAL_SENDERS=10
PATRONI_POSTGRESQL_PARAMETERS_SYNC_REPLICATION_SLOTS=on
PATRONI_POSTGRESQL_PARAMETERS_HOT_STANDBY_FEEDBACK=on
PATRONI_POSTGRESQL_PARAMETERS_WAL_KEEP_SIZE=1GB

# Test setting synchronized_standby_slots - this should be unique per node with our fix
PATRONI_POSTGRESQL_PARAMETERS_SYNCHRONIZED_STANDBY_SLOTS_TEMPLATE='${REPLICA_SLOT_NAMES}' 